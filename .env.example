# Copy this file to .env and update the values below
# NEVER commit your real .env file to GitHub.

# Application Settings
APP_NAME=ProductManagementAPI
APP_KEY=
APP_ENV=development

# Database Configuration (Aiven MySQL)
DB_DRIVER=mysql
DB_HOST=your-service-name.aivencloud.com
DB_PORT=12345
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password
DB_NAME=defaultdb
DB_CHARSET=utf8mb4
DB_PREFIX=

# Aiven requires SSL
DB_SSL=true
# Optional: path to Aiven's ca.pem (relative to project root). Download it from the Aiven service page.
DB_SSL_CA=certs/ca.pem
# Set to true to fully verify the server certificate (needs the correct DB_SSL_CA)
DB_SSL_VERIFY=false

# For API  (generate with: php lava jwt:generate --show)
JWT_SECRET=
REFRESH_TOKEN_KEY=

# Allowed frontend origin(s), comma separated, NO trailing slash
ALLOW_ORIGIN=http://localhost:5173
